{
  "name": "@enterprise-suite/product-plm",
  "version": "0.1.0",
  "description": "Product lifecycle management: catalog, variants, BOM, ECO, costing, UoM",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --dry 2>/dev/null || tsc -p tsconfig.json --noEmit",
    "test": "tsc -b tsconfig.json && node --import tsx --test \"tests/*.test.ts\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/http/main.ts"
  },
  "dependencies": {
    "@enterprise-suite/shared-kernel": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2"
  }
}
