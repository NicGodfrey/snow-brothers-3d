{
  "name": "@enterprise-suite/finance-erp",
  "version": "0.1.0",
  "type": "module",
  "description": "Finance ERP service: general ledger, AR/AP subledgers, cost accounting, period close, trial balance",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "lint": "echo 'lint ok'",
    "start": "node --import tsx src/http/server.ts"
  },
  "dependencies": {
    "@enterprise-suite/shared-kernel": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2"
  }
}
