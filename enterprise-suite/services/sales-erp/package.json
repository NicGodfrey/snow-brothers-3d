{
  "name": "@enterprise-suite/sales-erp",
  "version": "0.1.0",
  "description": "Sales bounded context: accounts, contacts, opportunities, quotes, sales orders, pricing, credit, returns",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"dist/tests/*.test.js\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/http/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
