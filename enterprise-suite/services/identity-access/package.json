{
  "name": "@enterprise-suite/identity-access",
  "version": "0.1.0",
  "description": "Identity & Access bounded context: tenants, users, groups, roles, permissions, role bindings, API keys, session tokens, RBAC evaluation and authorization audit",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "tsc -p tsconfig.typecheck.json",
    "start": "node --import tsx src/main.ts"
  },
  "dependencies": {
    "@enterprise-suite/shared-kernel": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
