{
  "name": "@enterprise-suite/marketing-erp",
  "version": "0.1.0",
  "description": "Marketing bounded context: campaigns, segments, leads, scoring, attribution, budgets, UTM tracking",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "demo": "node --import tsx src/demo.ts",
    "serve": "node --import tsx src/http/main.ts"
  },
  "dependencies": {
    "@enterprise-suite/shared-kernel": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
