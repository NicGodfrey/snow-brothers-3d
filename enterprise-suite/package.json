{
  "name": "@enterprise-suite/root",
  "private": true,
  "version": "0.1.0",
  "description": "ERP / SRM / PRM enterprise monorepo",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "count-loc": "node scripts/count-loc.js",
    "progress": "node scripts/scan-progress.mjs",
    "progress:serve": "node scripts/scan-progress.mjs && python3 -m http.server 8765 --directory docs --bind 127.0.0.1",
    "suite:start": "node scripts/start-suite.mjs",
    "suite:smoke": "node scripts/e2e-smoke.mjs",
    "suite:export": "node scripts/export-suite.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
